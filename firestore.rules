rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The public quote form is the only writer. Clients may create a request
    // (validated below) but can never read, edit or delete one back — only
    // the Cloud Function (Admin SDK) and the Firebase console can do that.
    match /quoteRequests/{requestId} {
      allow create: if
        request.resource.data.keys().hasAll(['fullName', 'phone', 'email', 'service', 'createdAt']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() < 200 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 && request.resource.data.phone.size() < 40 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 && request.resource.data.email.size() < 200 &&
        request.resource.data.service is string &&
        request.resource.data.service.size() > 0 &&
        request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
